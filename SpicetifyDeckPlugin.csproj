<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Company>CJ Hacker YT and NeonLightning</Company>
        <Authors>CJ Hacker YT; NeonLightning</Authors>
        <Product>SpicetifyDeck</Product>
        <Description>Control Spotify and Spicetify from your Macro Deck.</Description>
        <Version>2.6.1</Version>
        <RootNamespace>SpicetifyDeck</RootNamespace>
        <AssemblyName>SpicetifyDeck</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>

        <InternalsVisibleTo Include="SpicetifyDeck.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MacroDeck.Plugin.Analyzers" PrivateAssets="all" />
        <PackageReference Include="MacroDeck.Localization" />
        <PackageReference Include="MacroDeck.Plugin.Hosting" />
        <PackageReference Include="MacroDeck.Plugin.Serilog" />
        <PackageReference Include="MacroDeck.Sdk" />
        <PackageReference Include="MacroDeck.Ui" />
        <PackageReference Include="MacroDeck.Ui.Model" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Assets\icon.svg" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="macrodeck-build.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Bridge\spicetifydeck-bridge.js" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests\**" />
        <None Remove="tests\**" />
        <EmbeddedResource Remove="tests\**" />
    </ItemGroup>

</Project>
