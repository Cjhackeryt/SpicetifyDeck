{
  "version": 1,
  "include": [
    "Bridge/spicetifydeck-bridge.js"
  ],
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish", "SpicetifyDeckPlugin.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained", "false",
        "-p:UseAppHost=false",
        "-o", "bin/publish/win-x64"
      ],
      "output": "bin/publish/win-x64"
    },
    "linux-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish", "SpicetifyDeckPlugin.csproj",
        "-c", "Release",
        "-r", "linux-x64",
        "--self-contained", "false",
        "-p:UseAppHost=false",
        "-o", "bin/publish/linux-x64"
      ],
      "output": "bin/publish/linux-x64"
    },
    "arch-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish", "SpicetifyDeckPlugin.csproj",
        "-c", "Release",
        "-r", "arch-x64",
        "--self-contained", "false",
        "-p:UseAppHost=false",
        "-o", "bin/publish/arch-x64"
      ],
      "output": "bin/publish/arch-x64"
    },
    "osx-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish", "SpicetifyDeckPlugin.csproj",
        "-c", "Release",
        "-r", "osx-x64",
        "--self-contained", "false",
        "-p:UseAppHost=false",
        "-o", "bin/publish/osx-x64"
      ],
      "output": "bin/publish/osx-x64"
    },
    "osx-arm64": {
      "executable": "dotnet",
      "arguments": [
        "publish", "SpicetifyDeckPlugin.csproj",
        "-c", "Release",
        "-r", "osx-arm64",
        "--self-contained", "false",
        "-p:UseAppHost=false",
        "-o", "bin/publish/osx-arm64"
      ],
      "output": "bin/publish/osx-arm64"
    }
  }
}
