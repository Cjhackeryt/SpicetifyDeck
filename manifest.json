{
  "manifestVersion": 1,
  "id": "com.cjhackeryt.spicetifydeck",
  "name": "SpicetifyDeck",
  "version": "2.0.2",
  "description": "Control your Spotify desktop client from your Macro Deck through Spicetify. No Spotify account or developer setup required. Developed by cjhackeryt with contributions from NeonLightning. AI was used in the development of this plugin.",
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true
  },
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/SpicetifyDeck.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "linux-x64": {
      "executable": "runtimes/linux-x64/SpicetifyDeck.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "arch-x64": {
      "executable": "runtimes/arch-x64/SpicetifyDeck.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-x64": {
      "executable": "runtimes/osx-x64/SpicetifyDeck.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/SpicetifyDeck.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "cjhackeryt"
  },
  "repository": "https://github.com/Cjhackeryt/SpicetifyDeck",
  "license": "MIT",
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.15"
  }
}
